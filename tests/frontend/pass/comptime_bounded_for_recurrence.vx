// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 6 : i32

fn main() -> i32 {
  let value = comptime {
    let mut total : i32 = 0i32;
    for i in 0i32..4i32 {
      total += i;
    }
    total
  };
  return value;
}
