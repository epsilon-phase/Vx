// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// A declaration after `break` never opens a shadowing scope. Its mere presence must not restore
// the enclosing binding and discard the write that happened before the break.

fn main() -> i32 {
  let value = comptime {
    let mut total = 0i32;
    for i in 0i32..1i32 {
      total = 2i32;
      break;
      let total = i;
    }
    total
  };
  return value;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 2 : i32
