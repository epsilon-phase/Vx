// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 7 : i32

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  let value = comptime {
    let _from_if = if false {
      outside = 1i32;
      1i32
    } else {
      2i32
    };
    let _from_match = match 0i32 {
      1i32 => {
        outside = 2i32;
        1i32
      },
      _ => 2i32
    };
    7i32
  };
  return value;
}
