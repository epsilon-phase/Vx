// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

fn main(n : i32) -> i32 {
  let value = comptime {
    let _unused = if n > 0i32 {
      1i32
    } else {
      2i32
    };
    7i32
  };
  return value;
}
