// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// `Current` is the checker's active topology, so this predicate is just as concrete as one
// written with that topology explicitly.

fn main() -> i32 {
  let value = comptime {
    let _reachable = Reachable<Topology::Current, Topology::CPU>;
    7i32
  };
  return value;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 7 : i32
