// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn poke(p : *mut i32) -> i32 {
  unsafe { *p = 9i32; }
  return 0i32;
}

fn main() -> i32 {
  let value = comptime {
    let mut local = 1i32;
    let pointer : *mut i32 = &mut local;
    let _ignored = poke(pointer);
    local
  };
  return value;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @vx_init_signals() : () -> ()
// CHECK-NEXT: %[[VALUE:.*]] = arith.constant 9 : i32
// CHECK-NEXT: return %[[VALUE]] : i32
