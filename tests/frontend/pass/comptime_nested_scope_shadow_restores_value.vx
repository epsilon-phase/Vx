// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 7 : i32

fn main() -> i32 {
  let value = comptime {
    let selected : i32 = 7i32;
    let _ignored = if true {
      let selected : i32 = 9i32;
      selected
    } else {
      0i32
    };
    selected
  };
  return value;
}
