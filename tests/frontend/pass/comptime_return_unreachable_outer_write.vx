// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  let value = comptime {
    let selected = if true {
      if true {
        return 1i32;
      };
      outside = 5i32;
      2i32
    } else {
      3i32
    };
    selected
  };
  return value;
}
