// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 7 : i32

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main() -> i32 {
  let value = comptime {
    let mut predicate_local : i32 = 0i32;
    let _ignored = Reachable<Topology::CPU, Topology::NPU[touch(&mut predicate_local)]>;
    7i32
  };
  return value;
}
