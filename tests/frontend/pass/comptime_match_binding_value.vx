// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// A concrete identifier-pattern arm binds the scrutinee's value, not only its provenance.

fn main() -> i32 {
  let value = comptime {
    match 2i32 {
      number => number + 1i32
    }
  };
  return value;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 3 : i32
