// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 7 : i32

fn touch(value : &mut i32) -> bool {
  *value = 9i32;
  return true;
}

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  let value = comptime {
    // The call is syntactically present but semantically unreachable.
    let _ignored = false && touch(&mut outside);
    7i32
  };
  return value;
}
