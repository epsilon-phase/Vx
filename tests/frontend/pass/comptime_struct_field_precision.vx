// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// A read/write through `slot` must not inherit the mutable-reference provenance held in the
// unrelated `escaped` field. This runs under an unknown condition so the unified interpreter
// must retain the call's effects while selecting the member's precise facts.
struct Holder {
  slot : i32,
  escaped : &mut i32,
}

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(n : i32) -> i32 {
  let mut outer : i32 = 0i32;
  let value = comptime {
    let mut holder = Holder {
      slot : 0i32,
      escaped : &mut outer
    };
    let _ignored = if n > 0i32 {
      touch(&mut holder.slot)
    } else {
      1i32
    };
    7i32
  };
  return value;
}

// CHECK-LABEL: func.func @main
// CHECK: %c7_i32 = arith.constant 7 : i32
