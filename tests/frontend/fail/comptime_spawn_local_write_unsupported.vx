// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main() -> i32 {
  // `SpawnOn` has no comptime value semantics yet. A local-only effect must not make it vanish.
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let mut spawn_local : i32 = 0i32;
    let _ignored = spawn on(Topology::NPU[touch(&mut spawn_local)]) {
      let _local : i32 = 1i32;
    };
    7i32
  };
  return value;
}
