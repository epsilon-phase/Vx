// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> Tensor<i32, [1]> {
  *value = 9i32;
  return Tensor<i32, [1]>::new();
}

fn main() -> i32 {
  // `Transfer` has no comptime value semantics yet. A local-only effect must not make it vanish.
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let mut transfer_local : i32 = 0i32;
    let _ignored = transfer(touch(&mut transfer_local), Memory::NPU_HBM);
    7i32
  };
  return value;
}
