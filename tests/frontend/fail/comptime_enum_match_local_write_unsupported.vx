// RUN: not vxc %s 2>&1 | FileCheck %s

enum Choice {
  First,
  Second
}

fn main() -> i32 {
  // Enum-pattern values have no comptime value model yet; local writes must not make them vanish.
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let mut enum_match_local : i32 = 0i32;
    let choice = Choice::First;
    let _ignored = match choice {
      Choice::First => {
        enum_match_local = 9i32;
        1i32
      },
      Choice::Second => 2i32
    };
    7i32
  };
  return value;
}
