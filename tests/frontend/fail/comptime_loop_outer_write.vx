// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut loop_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'loop_outer'
  let value = comptime {
    loop {
      loop_outer = 9i32;
      break;
    }
    7i32
  };
  return value;
}
