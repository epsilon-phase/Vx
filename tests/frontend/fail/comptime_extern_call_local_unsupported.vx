// RUN: not vxc %s 2>&1 | FileCheck %s

extern {
  fn c_abs(value : i32) -> i32;
}

// An FFI declaration has no body the comptime interpreter can execute, so it cannot vanish
// before the literal tail.
fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let _ignored = unsafe { c_abs(1i32) };
    7i32
  };
  return value;
}
