// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut for_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'for_outer'
  let value = comptime {
    for i in 0i32..2i32 {
      for_outer = i;
    }
    7i32
  };
  return value;
}
