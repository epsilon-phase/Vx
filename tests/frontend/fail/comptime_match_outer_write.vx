// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let selected = if true {
      match 0i32 {
        _ => {
          outside = 4i32;
        }
      };
      1i32
    } else {
      2i32
    };
    selected
  };
  return value;
}
