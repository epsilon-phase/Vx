// RUN: not vxc %s 2>&1 | FileCheck %s

// The expanded vector element is still evaluated on the possible branch.
import std::vec;

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(n : i32) -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _items = if n > 0i32 {
      vec![ touch(&mut outside) ]
    } else {
      vec![ 1i32 ]
    };
    7i32
  };
  return value;
}
