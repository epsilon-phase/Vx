// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main() -> i32 {
  let mut asserted_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'asserted_outer'
  let value = comptime {
    assert(touch(&mut asserted_outer) == 1i32);
    7i32
  };
  return value;
}
