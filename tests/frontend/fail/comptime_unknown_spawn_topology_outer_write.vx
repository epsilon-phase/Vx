// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main(n : i32) -> i32 {
  let mut spawn_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'spawn_outer'
  let value = comptime {
    let _ignored = if n > 0i32 {
      spawn on(Topology::NPU[touch(&mut spawn_outer)]) {
        let _local : i32 = 1i32;
      }
      1i32
    } else {
      2i32
    };
    7i32
  };
  return value;
}
