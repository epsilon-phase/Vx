// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  // Inline MLIR has no comptime value semantics; local-only clobbers must not make it vanish.
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let mut mlir_local : i32 = 0i32;
    let _ignored = mlir!(inputs : (), clobbers : [mlir_local], returns : void, dialects : []) {
    };
    7i32
  };
  return value;
}
