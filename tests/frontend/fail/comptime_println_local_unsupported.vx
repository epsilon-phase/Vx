// RUN: not vxc %s 2>&1 | FileCheck %s

// `println` has the same observable-output boundary as `print`.
fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    println(1i32);
    7i32
  };
  return value;
}
