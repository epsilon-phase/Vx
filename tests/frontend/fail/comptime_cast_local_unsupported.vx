// RUN: not vxc %s 2>&1 | FileCheck %s

// Until comptime values retain their source and target scalar types, even a local scalar cast
// is deliberately refused rather than folded with guessed narrowing or signedness semantics.
fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let local : i32 = 7i32;
    let _cast = local as i64;
    0i32
  };
  return value;
}
