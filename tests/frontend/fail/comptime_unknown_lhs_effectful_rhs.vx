// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main(n : i32) -> i32 {
  let mut operator_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'operator_outer'
  let value = comptime {
    // An unknown left operand must not hide the write in the later right operand.
    let _ignored = n + touch(&mut operator_outer);
    7i32
  };
  return value;
}
