// RUN: not vxc %s 2>&1 | FileCheck %s

fn identity(x : f32) -> f32 {
  return x;
}

fn touch(value : &mut i32) -> f32 {
  *value = 9i32;
  return 1.0;
}

// Autodiff is refused, but its eager argument evaluation must retain this outer write.
fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _derivative = grad(identity, touch(&mut outside));
    7i32
  };
  return value;
}
