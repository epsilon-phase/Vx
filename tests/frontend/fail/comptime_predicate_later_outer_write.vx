// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main() -> i32 {
  let mut predicate_direct_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'predicate_direct_outer'
  let value = comptime {
    let _ignored = Reachable<Topology::CPU, Topology::NPU[touch(&mut predicate_direct_outer)]>;
    7i32
  };
  return value;
}
