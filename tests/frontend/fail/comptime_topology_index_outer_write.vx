// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main() -> i32 {
  let mut topology_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'topology_outer'
  let value = comptime {
    let _ignored = Topology::NPU[touch(&mut topology_outer)];
    7i32
  };
  return value;
}
