// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main() -> i32 {
  let mut spawn_direct_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'spawn_direct_outer'
  let value = comptime {
    let _ignored = spawn on(Topology::NPU[touch(&mut spawn_direct_outer)]) {
      let _local : i32 = 1i32;
    };
    7i32
  };
  return value;
}
