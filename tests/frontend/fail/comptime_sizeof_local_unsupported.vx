// RUN: not vxc %s 2>&1 | FileCheck %s

// Scalar and pointer `sizeof` values fold in comptime. A tensor's layout needs the code
// generator's nominal-type registry, which this interpreter deliberately does not own, so it
// must not disappear before the later literal is folded.
fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let _size = sizeof<Tensor<f32, []>>();
    7i32
  };
  return value;
}
