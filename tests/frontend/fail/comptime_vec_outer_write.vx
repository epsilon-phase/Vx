// RUN: not vxc %s 2>&1 | FileCheck %s

// Macro lowering must not hide a write in a vector element behind the generated allocation and
// push calls.
import std::vec;

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _items = vec![ touch(&mut outside) ];
    7i32
  };
  return value;
}
