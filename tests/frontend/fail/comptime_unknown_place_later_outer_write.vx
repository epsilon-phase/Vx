// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(n : i32) -> i32 {
  let mut place_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'place_outer'
  let value = comptime {
    let mut local : Tensor<i32, [1]> = [ 0i32 ];
    // An unknown store index must not hide the later right-hand-side borrow and call.
    local[n] = touch(&mut place_outer);
    7i32
  };
  return value;
}
