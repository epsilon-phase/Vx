// RUN: not vxc %s 2>&1 | FileCheck %s

struct Holder {
  value : &mut i32,
}

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn through_immutable_borrow(holder : &Holder) -> i32 {
  return touch(holder.value);
}

fn through_mutable_borrow(holder : &mut Holder) -> i32 {
  return touch(holder.value);
}

fn immutable_holder(n : i32) -> i32 {
  let mut immutable_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'immutable_outer'
  let value = comptime {
    let holder = Holder {
      value : &mut immutable_outer
    };
    let _ignored = if n > 0i32 {
      through_immutable_borrow(&holder)
    } else {
      1i32
    };
    7i32
  };
  return value;
}

fn mutable_holder(n : i32) -> i32 {
  let mut mutable_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'mutable_outer'
  let value = comptime {
    let mut holder = Holder {
      value : &mut mutable_outer
    };
    let _ignored = if n > 0i32 {
      through_mutable_borrow(&mut holder)
    } else {
      1i32
    };
    7i32
  };
  return value;
}
