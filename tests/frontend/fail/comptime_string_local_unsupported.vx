// RUN: not vxc %s 2>&1 | FileCheck %s

// Strings are not representable by the transition comptime value model, so this local use must
// not vanish before the later literal is folded.
fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let _text = "not a comptime value";
    7i32
  };
  return value;
}
