// RUN: not vxc %s 2>&1 | FileCheck %s

fn identity(x : f32) -> f32 {
  return x;
}

// A JVP result is not a comptime Value and must not vanish before the literal tail.
fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let _derivative = jvp(identity, 1.0, 1.0);
    7i32
  };
  return value;
}
