// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(deref_outer : &mut i32) -> i32 {
  let _callback = touch;
  // CHECK: Error[E3033]{{.*}}writes to 'deref_outer'
  let value = comptime {
    let _ignored = _callback(&mut *deref_outer);
    7i32
  };
  return value;
}
