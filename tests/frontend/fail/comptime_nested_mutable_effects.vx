// RUN: not vxc %s 2>&1 | FileCheck %s

struct Cell {
  value : i32,
}

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(n : i32) -> i32 {
  let mut nested_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'nested_outer'
  let value = comptime {
    let _ignored = if n > 0i32 {
      let cell = Cell {
        value : touch(&mut nested_outer)
      };
      cell.value
    } else {
      1i32
    };
    7i32
  };
  return value;
}
