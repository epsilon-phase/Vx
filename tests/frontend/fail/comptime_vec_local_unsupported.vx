// RUN: not vxc %s 2>&1 | FileCheck %s

// `vec!` lowers to allocation and mutable push calls. It is not a comptime value and must not
// disappear simply because the block has a foldable tail.
import std::vec;

fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let _items = vec![ 1i32, 2i32 ];
    0i32
  };
  return value;
}
