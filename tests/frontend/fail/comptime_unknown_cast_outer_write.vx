// RUN: not vxc %s 2>&1 | FileCheck %s

// The abstract arm reaches the same cast operand. Its write cannot disappear just because the
// condition is not known while compiling.
fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(n : i32) -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _ignored = if n > 0i32 {
      touch(&mut outside) as i64
    } else {
      1i64
    };
    7i32
  };
  return value;
}
