// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(reborrow_outer : &mut &mut i32, n : i32) -> i32 {
  let _callback = touch;
  // CHECK: Error[E3033]{{.*}}writes to 'reborrow_outer'
  let value = comptime {
    let _ignored = if n > 0i32 {
      _callback(*reborrow_outer)
    } else {
      1i32
    };
    7i32
  };
  return value;
}
