// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main(values : Tensor<i32, [1]>) -> i32 {
  let mut index_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'index_outer'
  let value = comptime {
    // `values` is unknown to the legacy evaluator. Its index still executes first at run time.
    let _ignored = values[touch(&mut index_outer)];
    7i32
  };
  return value;
}
