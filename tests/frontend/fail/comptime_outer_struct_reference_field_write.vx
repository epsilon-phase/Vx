// RUN: not vxc %s 2>&1 | FileCheck %s

struct Wrapper {
  reference : &mut i32,
}

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main() -> i32 {
  let mut outside = 1i32;
  let wrapper = Wrapper {
    reference : &mut outside
  };
  // CHECK: Error[E3033]{{.*}}writes to 'wrapper'
  let value = comptime {
    let _ignored = touch(wrapper.reference);
    7i32
  };
  return value;
}
