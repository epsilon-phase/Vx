// RUN: not vxc %s 2>&1 | FileCheck %s

// Argument evaluation precedes the print refusal, so the specific escaping write wins.
fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    print(touch(&mut outside));
    7i32
  };
  return value;
}
