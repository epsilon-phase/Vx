// RUN: not vxc %s 2>&1 | FileCheck %s

// A fall-through function call must retain its body's refusal state. Otherwise the print can
// disappear and the trailing literal can be folded by itself.

fn log() -> void {
  print(5i32);
}

fn main() -> i32 {
  // CHECK: Error[E3033]{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    log();
    7i32
  };
  return value;
}
