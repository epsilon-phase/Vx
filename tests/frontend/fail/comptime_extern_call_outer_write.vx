// RUN: not vxc %s 2>&1 | FileCheck %s

extern {
  fn c_touch(value : &mut i32) -> i32;
}

// The unavailable FFI body may write through its mutable argument, so retain the actual outer
// binding instead of reporting only a generic refusal.
fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _ignored = unsafe { c_touch(&mut outside) };
    7i32
  };
  return value;
}
