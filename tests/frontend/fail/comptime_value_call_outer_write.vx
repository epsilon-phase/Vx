// RUN: not vxc %s 2>&1 | FileCheck %s

fn bump(p : &mut Tensor<i32, [1]>) -> i32 {
  p[0] = 9i32;
  return 1i32;
}

fn main() -> i32 {
  let mut outside : Tensor<i32, [1]> = [ 0i32 ];
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _ignored = bump(&mut outside);
    1i32
  };
  return value;
}
