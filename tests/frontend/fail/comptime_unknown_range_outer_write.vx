// RUN: not vxc %s 2>&1 | FileCheck %s

// An unknown branch cannot hide a write in the range's first bound.
fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 0i32;
}

fn main(n : i32) -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let _range = if n > 0i32 {
      touch(&mut outside)..2i32
    } else {
      0i32..2i32
    };
    7i32
  };
  return value;
}
