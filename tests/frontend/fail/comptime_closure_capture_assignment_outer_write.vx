// RUN: not vxc %s 2>&1 | FileCheck %s

fn main(n : i32) -> i32 {
  let mut captured_outer : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'captured_outer'
  let value = comptime {
    let _ignored = if n > 0i32 {
      let callback = || comptime {
        captured_outer = 9i32;
        0i32
      };
      callback()
    } else {
      1i32
    };
    7i32
  };
  return value;
}
