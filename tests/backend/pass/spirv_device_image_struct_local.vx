// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// A struct-valued local inside a placed region keeps the region on the host,
// and the compiler says so.
//
// The flat emitter gives such a local an `llvm.alloca` slot and reads and
// writes it with `llvm.getelementptr`/`llvm.store`/`llvm.load`. Those are
// `llvm` ops, which is not a dialect the device pipelines were measured on, so
// the body is classified not-device-ready and no device twin is built. The
// alternative -- a twin that is built and then fails in the backend -- is
// worse, and so is silence: the program computes the right values, one thread
// at a time, and its author believes it ran on the card.
//
// The carried value is not the trivial one: an `llvm.alloca` in address space
// 0 becomes SPIR-V `Function` storage, and `spirv-val` accepts it (measured on
// a one-alloca module with `llc -mtriple=spirv64-unknown-unknown`). A stack
// slot is not itself what SPIR-V cannot express -- the gate below is what keeps
// this body at home, so the region is compiled for the host and the warning is
// what makes that visible.
//
// device_image_test.rs asserts the warning and the absent image.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: vx.spawn topology({{[0-9]+}}) {
// CHECK: } {arch = "spirv64"
// EXPECT: [4,  6,  8,  10]

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: spirv64,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 63 GB/s
}

struct Pair {
  a : f32,
  b : f32,
}

fn main() -> i32 {
  let mut o = Tensor<f32, [4]>::uninit();
  for i in 0..4 {
    o[i] = 0.0;
  }
  let mut od = transfer(o, Memory::GPU_HBM);
  spawn on(Topology::Dev) {
    for i in 0..4 {
      // A struct local: one field is written, then read back.
      let mut p : Pair = Pair {
        a : ((i + 1) as f32), b : 2.0
      };
      p.a = p.a + 1.0;
      od[i] = p.a * p.b;
    }
  }
  let home = transfer(od, Memory::CPU_DRAM);
  print(home);
  return 0;
}
